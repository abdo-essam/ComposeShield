<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Both permissions are protectionLevel="normal": granted at install time, with no runtime
      prompt and no user-facing dialog, and neither grants access to any data. They are what the
      OS requires to *notify* the app that a capture happened — they do not permit reading a
      capture, the screen, or storage, and do not access any user data.

      Merged into consuming apps automatically. An app that wants neither detection capability can
      remove them with tools:node="remove"; the corresponding capability then reports unsupported
      rather than failing.
    -->

    <!-- Capability.ScreenshotEvents — Activity.registerScreenCaptureCallback, API 34+. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <!-- Capability.CaptureDetection — WindowManager.addScreenRecordingCallback, API 35+. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <application>
        <!--
          Initializes ComposeShield's activity-lifecycle tracker before any Activity.onCreate runs.

          This is the standard library-initialization pattern (WorkManager, Firebase, Glide) that
          guarantees ActivityLifecycleCallbacks are registered before the first onResume, so
          ComposeShield.protect() works correctly without any user call-site setup.

          Applications that suppress manifest merging with tools:node="remove" must register their
          own ActivityLifecycleCallbacks on the Application before any activity resumes (the
          equivalent of installActivityTracker) or ComposeShield.protect() may be unable to locate
          the target window on the first launch.
        -->
        <provider
            android:name="io.github.composeshield.internal.ComposeShieldInitializer"
            android:authorities="${applicationId}.composeshield-init"
            android:exported="false"
            android:multiprocess="false" />
    </application>

</manifest>
